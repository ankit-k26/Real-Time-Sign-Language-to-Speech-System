# ─────────────────────────────────────────────────────────────
#  Sign Language to Speech System — Backend Environment Config
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini API (LLM Interpreter) ──────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model to use for sentence interpretation
# Options: gemini-3.6-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-3.7-flash

# ── LLM Settings ─────────────────────────────────────────────
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=30

# ── TTS Settings ─────────────────────────────────────────────
# Backend: pyttsx3 (offline) or gtts (online, requires internet)
TTS_BACKEND=pyttsx3
TTS_RATE=175
TTS_VOLUME=0.9
TTS_VOICE_INDEX=0

# ── Inference Thresholds ──────────────────────────────────────
CONFIDENCE_THRESH=0.70
SAME_WORD_STREAK=8
PAUSE_SECONDS=2.5
MAX_TOKEN_BUFFER=20

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated list of allowed origins (* = all)
# Tighten this in production, e.g.: http://localhost:5173
ALLOWED_ORIGINS=*
