# ─────────────────────────────────────────────────────────────
#  Sign Language to Speech System — Frontend Environment Config
#  Vite exposes only variables prefixed with VITE_ to the browser.
#  Copy this file to .env and update values for your environment.
# ─────────────────────────────────────────────────────────────

# ── Backend API URLs ──────────────────────────────────────────
# Base URL for REST calls (health, labels, tts)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket base URL for inference and collection streams
VITE_WS_BASE_URL=ws://localhost:8000
